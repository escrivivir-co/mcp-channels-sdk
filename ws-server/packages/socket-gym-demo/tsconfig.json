{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "lib": ["ES2019"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@alephscript/core": ["../alephscript-core/src"],
      "@alephscript/core/*": ["../alephscript-core/src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../alephscript-core/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
